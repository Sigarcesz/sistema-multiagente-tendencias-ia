# Copia este archivo como .env (no se sube a git) y pon tu key.
OPENAI_API_KEY=sk-...

# Modelo para todos los agentes. Revisa en tu panel de OpenAI qué modelos tienes disponibles.
MODELO=gpt-5-mini

# Opcional: un modelo distinto por agente (si se omite, usa MODELO)
# MODELO_ORQUESTADOR=
# MODELO_SCOUT=
# MODELO_ESCRITOR=
# MODELO_AUDITOR=

# 1 = no enviar trazas al panel de OpenAI (por defecto sí se envían y puedes verlas en platform.openai.com > Traces)
# DESACTIVAR_TRACING=1

# --- v2: latencia ---
# Máximo de especialistas trabajando a la vez (Scouts por tendencia, auditores por tendencia)
# MAX_PARALELO=4
# Esfuerzo de razonamiento por rol: minimal | low | medium | high (vacío = el del modelo)
# ESFUERZO_ORQUESTADOR=low
# ESFUERZO_SCOUT=
# ESFUERZO_ESCRITOR=
# ESFUERZO_AUDITOR=
# 0 = no mostrar en la terminal cada herramienta que usan los agentes
# PROGRESO=1
